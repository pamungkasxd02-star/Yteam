# Local runtime and generated assessment data
runtime/
*.log
*.stderr.txt
*.stdout.txt

# Upstream sources are reproducibly fetched by scripts/bootstrap_sources.py.
# Keep nested Git checkouts out of the Yteam repository (avoid embedded-repo
# gitlinks and avoid redistributing third-party source/data accidentally).
/vendor/*/
!/vendor/SOURCES.md

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Credentials and private local profile state
.env
profile/.env
runtime/yteam-hermes-home/
runtime/yteam-model.yaml
runtime/yteam-model.local.yaml
yteam.local.yaml
auth.json
auth.lock
camoufox-cache/
playwright-cache/
.camoufox/

# Engagement-local artifacts must never be published by default
reports/
evidence/
recon/
secrets/
packs/

# Local dependency trees / build output
node_modules/
vendor/*/node_modules/
vendor/*/.venv/
vendor/*/venv/
vendor/*/bin/
vendor/*/dist/
vendor/*/build/

# OS/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local CI/build metadata
.coverage
coverage.xml
htmlcov/
.ruff_cache/
